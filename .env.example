# ==============================================================================
# AgentGuard Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=agentguard
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=agentguard_secret

# Spring Boot Configuration
# Use 'dev' for in-memory H2 + dev tamper demo endpoint
# Use 'prod' for PostgreSQL Flyway production configuration
SPRING_PROFILES_ACTIVE=dev

# Gateway Risk Router & LLM Judge Mode
# Options: 'mock' (default, free & offline), 'ollama' (local LLM), 'gemini' (Google Cloud)
AGENTGUARD_JUDGE_TYPE=mock
OLLAMA_HOST=http://localhost:11434
OLLAMA_ENABLED=false
GEMINI_API_KEY=

# Port Bindings
BACKEND_PORT=8080
FRONTEND_PORT=3000
